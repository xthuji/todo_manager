{
  "coding_rules": [
    {
      "rule_id": "SERVER_PORT_PROTECTION",
      "description": "不要修改服务端的启动端口",
      "severity": "high",
      "scope": ["server"]
    },
    {
      "rule_id": "NO_HARDCODED_DATA",
      "description": "服务端业务代码中不要使用降级默认数据或做硬编码特殊处理，所有业务数据都需要严格从指定的业务来源中获取",
      "severity": "high",
      "scope": ["server"]
    },
    {
      "rule_id": "PAGE_PATH_ROOT_FORMAT",
      "description": "所有页面的访问路径应该直接使用根路径的形式，比如 http://localhost:3000/weather_view.html，http://localhost:3000/index.html",
      "severity": "medium",
      "scope": ["client"]
    },
    {
      "rule_id": "NEW_PAGE_TEST_REQUIREMENT",
      "description": "添加新的页面时，同时创建对应的测试js文件，添加核心功能的测试用例",
      "severity": "medium",
      "scope": ["client", "tests"]
    },
    {
      "rule_id": "STATIC_FILE_REUSE",
      "description": "页面使用的静态文件参考其他已有页面，优先复用本地已存在的",
      "severity": "low",
      "scope": ["client"]
    },
    {
      "rule_id": "INDEX_PAGE_INTEGRATION",
      "description": "新页面还需要仿照其他业务在index页面中添加侧边栏按钮，使用iframe方式引用页面",
      "severity": "medium",
      "scope": ["client"]
    }
  ],
  "file_structure": {
    "test_files": {
      "description": "所有生成的测试js文件都应该放在此目录",
      "path": "~/work/MyProject/code_mine/gitee/node_app/todolist/src/tests/",
      "file_pattern": "*.js"
    },
    "html_pages": {
      "description": "所有html页面文件都应该放在此目录",
      "path": "~/work/MyProject/code_mine/gitee/node_app/todolist/src/client/pages/",
      "file_pattern": "*.html"
    },
    "static_files": {
      "description": "所有静态文件都应该放在此目录的相应子目录中",
      "path": "~/work/MyProject/code_mine/gitee/node_app/todolist/src/client/assets/",
      "subdirectories": ["css", "js", "fonts"]
    },
    "data_files": {
      "description": "所有本地数据和配置文件都应该放在此目录",
      "path": "~/work/MyProject/code_mine/gitee/node_app/todolist/data/",
      "file_types": ["json", "txt", "config"]
    },
    "data_scripts": {
      "description": "所有数据文件的处理脚本都应该放在此目录",
      "path": "~/work/MyProject/code_mine/gitee/node_app/todolist/src/server/data_scripts/",
      "file_pattern": "*.js"
    },
    "logs_directory": {
      "description": "所有日志输出都应该放在此目录",
      "path": "~/work/MyProject/code_mine/gitee/node_app/todolist/logs/"
    }
  },
  "project_info": {
    "name": "todolist",
    "root_path": "~/work/MyProject/code_mine/gitee/node_app/todolist/",
    "created_at": "2023-11-06",
    "rules_version": "1.0.0"
  }
}